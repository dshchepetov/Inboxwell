<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Gomail_App.DraftsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Gomail_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Drafts &amp; outbox"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Grid x:Name="DraftsRoot" Background="{ThemeResource GomailCanvasBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><CompositeTransform x:Name="DraftsTransform" TranslateY="9" /></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="DraftsTitleBar" Title="Drafts &amp; outbox"><TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource></TitleBar>
        <Grid Grid.Row="1" Padding="26,20,26,22" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><StackPanel Spacing="4"><TextBlock Text="Drafts &amp; outbox" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="DraftCountText" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource GomailIconButtonStyle}" ToolTipService.ToolTip="Refresh" Click="Refresh_Click"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button></Grid>
            <Grid Grid.Row="1">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"><Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource GomailMutedBrush}"><FontIcon Glyph="&#xE70B;" FontSize="23" /></Border><TextBlock Text="Nothing waiting here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Saved drafts and queued messages will appear here." FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                <ListView x:Name="DraftsList" SelectionMode="Single" ItemContainerStyle="{StaticResource GomailListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,11" MinHeight="82"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold" /><Border Padding="7,2" Background="{ThemeResource GomailAccentSoftBrush}" CornerRadius="7"><TextBlock Text="{Binding State}" FontSize="10" Foreground="{ThemeResource GomailAccentBrush}" /></Border></StackPanel><TextBlock Text="{Binding Recipients}" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Error}" FontSize="10" Foreground="{ThemeResource GomailDangerBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Updated}" FontSize="10" Foreground="{ThemeResource GomailMutedTextBrush}" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Row="2"><TextBlock x:Name="DraftStatus" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right"><Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource GomailSecondaryButtonStyle}" Foreground="{ThemeResource GomailDangerBrush}" Click="Delete_Click" /><Button x:Name="RetryButton" Content="Retry send" Style="{StaticResource GomailSecondaryButtonStyle}" Click="Retry_Click" /><Button x:Name="OpenButton" Content="Open draft" Style="{StaticResource GomailPrimaryButtonStyle}" Click="Open_Click" /></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
