<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Gomail_App.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Gomail_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="New message"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>

    <Grid x:Name="ComposeRoot" Background="{ThemeResource GomailCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <TitleBar x:Name="ComposeTitleBar" Title="New message">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="24,18,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ThreadContextCard" Visibility="Collapsed" Padding="12,9" Background="{ThemeResource GomailAccentSoftBrush}" CornerRadius="10" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE97A;" FontSize="13" Foreground="{ThemeResource GomailAccentBrush}" VerticalAlignment="Top" Margin="2,3,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="ThreadContextSubject" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ThreadContextSender" FontSize="10" Foreground="{ThemeResource GomailSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ThreadContextBody" FontSize="10" Foreground="{ThemeResource GomailSecondaryTextBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="SelectorGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SignatureColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SignatureRow" Height="Auto" /></Grid.RowDefinitions>
                <ComboBox x:Name="FromPicker" Header="From" Style="{StaticResource GomailComboBoxStyle}" SelectionChanged="FromPicker_SelectionChanged" />
                <ComboBox x:Name="SignaturePicker" Grid.Row="1" Header="Signature" Style="{StaticResource GomailComboBoxStyle}" SelectionChanged="SignaturePicker_SelectionChanged" />
            </Grid>

            <Border Grid.Row="2" Background="{ThemeResource GomailCardBrush}" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition x:Name="CcRow" Height="0" /><RowDefinition x:Name="BccRow" Height="0" /></Grid.RowDefinitions>
                    <TextBlock Text="To" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <AutoSuggestBox x:Name="ToBox" Grid.Column="1" Margin="0,3" Style="{StaticResource GomailAutoSuggestBoxStyle}" BorderThickness="0" Background="Transparent" PlaceholderText="Name or email address" UpdateTextOnSelect="False" TextChanged="RecipientBox_TextChanged" SuggestionChosen="RecipientBox_SuggestionChosen" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                        <Button Content="Cc" Style="{StaticResource GomailRoundedButtonStyle}" Padding="8,4" MinHeight="28" Click="ToggleCc_Click" />
                        <Button Content="Bcc" Style="{StaticResource GomailRoundedButtonStyle}" Padding="8,4" MinHeight="28" Click="ToggleBcc_Click" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="1" Text="Cc" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource GomailSecondaryTextBrush}" />
                    <TextBox x:Name="CcBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,8,3" Padding="0" Style="{StaticResource GomailSingleLineTextBoxStyle}" BorderThickness="0" Background="Transparent" PlaceholderText="Carbon copy" TextChanged="Field_TextChanged" />

                    <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="2" Text="Bcc" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource GomailSecondaryTextBrush}" />
                    <TextBox x:Name="BccBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,8,3" Padding="0" Style="{StaticResource GomailSingleLineTextBoxStyle}" BorderThickness="0" Background="Transparent" PlaceholderText="Blind carbon copy" TextChanged="Field_TextChanged" />
                </Grid>
            </Border>

            <TextBox x:Name="SubjectBox" Grid.Row="3" Style="{StaticResource GomailFieldStyle}" Header="Subject" PlaceholderText="What is this message about?" TextChanged="Field_TextChanged" />

            <Border Grid.Row="4" Height="40" Background="{ThemeResource GomailPanelBrush}" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,0">
                <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="4,0" VerticalAlignment="Center">
                            <TextBlock Text="Size" Margin="4,0,3,0" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="FontSizePicker" Width="92" Height="32" MinHeight="32" Padding="10,0,30,0" Style="{StaticResource GomailComboBoxStyle}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTipService.ToolTip="Font size" SelectedIndex="1" SelectionChanged="FontSizePicker_SelectionChanged">
                                <x:String>11 pt</x:String><x:String>13 pt</x:String><x:String>16 pt</x:String><x:String>20 pt</x:String><x:String>26 pt</x:String>
                            </ComboBox>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Bold" Click="Bold_Click"><FontIcon Glyph="&#xE8DD;" FontSize="13" /></Button>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Italic" Click="Italic_Click"><FontIcon Glyph="&#xE8DB;" FontSize="13" /></Button>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Underline" Click="Underline_Click"><FontIcon Glyph="&#xE8DC;" FontSize="13" /></Button>
                            <Rectangle Width="1" Height="18" Margin="3,0" Fill="{ThemeResource GomailBorderBrush}" />
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Bulleted list" Click="Bullet_Click"><FontIcon Glyph="&#xE8FD;" FontSize="13" /></Button>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Numbered list" Click="NumberedList_Click"><FontIcon Glyph="&#xE8EF;" FontSize="13" /></Button>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Attach files" Click="Attach_Click"><FontIcon Glyph="&#xE723;" FontSize="13" /></Button>
                            <Rectangle Width="1" Height="18" Margin="3,0" Fill="{ThemeResource GomailBorderBrush}" />
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Undo" Click="Undo_Click"><FontIcon Glyph="&#xE7A7;" FontSize="13" /></Button>
                            <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Redo" Click="Redo_Click"><FontIcon Glyph="&#xE7A6;" FontSize="13" /></Button>
                    </StackPanel>
                <ToggleButton x:Name="ImportantToggle" Grid.Column="1" Style="{StaticResource GomailImportanceToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="High importance" AutomationProperties.Name="High importance" Checked="ImportantToggle_Changed" Unchecked="ImportantToggle_Changed">
                    <TextBlock Text="!" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                </ToggleButton>
                </Grid>
            </Border>

            <Border Grid.Row="5" Background="{ThemeResource GomailCardBrush}" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8">
                <Grid>
                    <RichEditBox x:Name="BodyEditor" MinHeight="130" BorderThickness="0" Background="Transparent" FontSize="13" PlaceholderText="Write your message…" IsSpellCheckEnabled="True" TextChanged="BodyEditor_TextChanged" SelectionChanged="BodyEditor_SelectionChanged" />
                </Grid>
            </Border>

            <ItemsControl x:Name="AttachmentsList" Grid.Row="6">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,6" Padding="10,6" Background="{ThemeResource GomailAccentSoftBrush}" CornerRadius="9">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE723;" FontSize="12" Foreground="{ThemeResource GomailAccentBrush}" />
                                <TextBlock Text="{Binding FileName}" FontSize="11" VerticalAlignment="Center" />
                                <Button Tag="{Binding}" Style="{StaticResource GomailRoundedButtonStyle}" Width="24" Height="24" MinHeight="24" Padding="0" ToolTipService.ToolTip="Remove attachment" Click="RemoveAttachment_Click"><FontIcon Glyph="&#xE711;" FontSize="9" /></Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="7" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="SaveStatus" Text="Compose stays open while you read mail" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" />
                    <InfoBar x:Name="ComposeInfoBar" IsOpen="False" IsClosable="True" MaxWidth="560" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Content="Save draft" MinHeight="38" Padding="15,0" Style="{StaticResource GomailSecondaryButtonStyle}" Click="SaveAndClose_Click" />
                    <Button x:Name="SendButton" MinHeight="38" Padding="16,0" Style="{StaticResource GomailPrimaryButtonStyle}" ToolTipService.ToolTip="Send" Click="Send_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><FontIcon Glyph="&#xE724;" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="Send" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactCompose" />
                <VisualState x:Name="WideCompose">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SignatureColumn.Width" Value="300" />
                        <Setter Target="SignatureRow.Height" Value="0" />
                        <Setter Target="SignaturePicker.(Grid.Row)" Value="0" />
                        <Setter Target="SignaturePicker.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
