<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Gomail_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Gomail_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Gomail_App.ViewModels"
    Title="Settings"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>

    <Grid x:Name="SettingsRoot" Background="{ThemeResource GomailCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <TitleBar x:Name="SettingsTitleBar" Title="Settings">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsNavColumn" Width="224" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border x:Name="SettingsSidebar" Background="{ThemeResource GomailPanelBrush}">
                <Grid Padding="12,20,12,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="6,0,0,16" Orientation="Horizontal" Spacing="7"><Image Source="Assets/InboxwellIcon.png" Width="26" Height="26" Stretch="Uniform" /><TextBlock Text="Inboxwell settings" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <ListView x:Name="SettingsNav" Grid.Row="1" SelectionChanged="SettingsNav_SelectionChanged" ItemContainerStyle="{StaticResource GomailListViewItemStyle}">
                        <ListViewItem Tag="general"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE713;" FontSize="14" /><TextBlock Text="General" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="accounts"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE77B;" FontSize="14" /><TextBlock Text="Accounts" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="signatures"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE70B;" FontSize="14" /><TextBlock Text="Signatures" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="shortcuts"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE765;" FontSize="14" /><TextBlock Text="Keyboard shortcuts" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="integrations"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE774;" FontSize="14" /><TextBlock Text="Integrations" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="privacy"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE72E;" FontSize="14" /><TextBlock Text="Security &amp; privacy" /></StackPanel></ListViewItem>
                        <ListViewItem Tag="about"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE946;" FontSize="14" /><TextBlock Text="About" /></StackPanel></ListViewItem>
                    </ListView>
                    <Border Grid.Row="2" Padding="10" Background="{ThemeResource GomailAccentSoftBrush}" CornerRadius="10">
                        <StackPanel Spacing="4"><TextBlock Text="Local first" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource GomailAccentBrush}" /><TextBlock Text="Mail stays encrypted on this PC." FontSize="10" Foreground="{ThemeResource GomailSecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource GomailBorderBrush}" />

            <Grid Grid.Column="2" Padding="28,20,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ComboBox x:Name="CompactNavigation" Margin="0,0,0,14" Style="{StaticResource GomailComboBoxStyle}" Visibility="Collapsed" SelectionChanged="CompactNavigation_SelectionChanged">
                    <ComboBoxItem Content="General" Tag="general" /><ComboBoxItem Content="Accounts" Tag="accounts" /><ComboBoxItem Content="Signatures" Tag="signatures" /><ComboBoxItem Content="Keyboard shortcuts" Tag="shortcuts" /><ComboBoxItem Content="Integrations" Tag="integrations" /><ComboBoxItem Content="Security &amp; privacy" Tag="privacy" /><ComboBoxItem Content="About" Tag="about" />
                </ComboBox>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="GeneralPage">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="General" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Choose how Inboxwell behaves on this computer." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <ToggleSwitch x:Name="NotificationsToggle" Header="New mail notifications" OnContent="On" OffContent="Off">
                                        <ToggleSwitch.Resources>
                                            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="GomailAccentBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="GomailAccentBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="GomailAccentHoverBrush" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="Keep syncing after the window closes" OnContent="Keep in system tray" OffContent="Exit on close">
                                        <ToggleSwitch.Resources>
                                            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="GomailAccentBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="GomailAccentBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                            <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="GomailAccentHoverBrush" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="Reading pane" FontWeight="SemiBold" /><TextBlock Text="Show messages beside or below the conversation list." FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                    <ComboBox x:Name="ReadingPanePicker" Grid.Column="1" Style="{StaticResource GomailComboBoxStyle}" SelectedIndex="0"><ComboBoxItem Content="On the right" Tag="right" /><ComboBoxItem Content="At the bottom" Tag="bottom" /></ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="Appearance" FontWeight="SemiBold" /><TextBlock Text="Use the Windows theme or choose one for Inboxwell." FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                                    <ComboBox x:Name="ThemePicker" Grid.Column="1" Style="{StaticResource GomailComboBoxStyle}" SelectedIndex="0"><ComboBoxItem Content="Use system setting" Tag="system" /><ComboBoxItem Content="Light" Tag="light" /><ComboBoxItem Content="Dark" Tag="dark" /></ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AccountsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="Accounts" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Connection state and controls for every mailbox." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <ListView x:Name="AccountsList" MinHeight="180" MaxHeight="360" SelectionMode="Single" ItemContainerStyle="{StaticResource GomailListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountItem">
                                        <Grid Padding="12,10" MinHeight="68"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource GomailAccentSoftBrush}"><TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource GomailAccentBrush}" FontWeight="SemiBold" FontSize="11" /></Border>
                                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Email}" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><TextBlock Text="{x:Bind SyncStatus}" FontSize="10" Foreground="{ThemeResource GomailMutedTextBrush}" /></StackPanel>
                                            <Border Grid.Column="2" Padding="8,3" VerticalAlignment="Center" Background="{ThemeResource GomailMutedBrush}" CornerRadius="8"><TextBlock Text="{x:Bind Subtitle}" FontSize="10" /></Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Button Content="Rename" Style="{StaticResource GomailSecondaryButtonStyle}" Click="RenameAccount_Click" />
                                <Button Content="Reconnect" Style="{StaticResource GomailSecondaryButtonStyle}" Click="ReconnectAccount_Click" />
                                <Button x:Name="ToggleAccountButton" Content="Enable / disable" Style="{StaticResource GomailSecondaryButtonStyle}" Click="ToggleAccount_Click" />
                                <Button Content="Remove" Style="{StaticResource GomailSecondaryButtonStyle}" Foreground="{ThemeResource GomailDangerBrush}" Click="RemoveAccount_Click" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Style="{StaticResource GomailPrimaryButtonStyle}" Click="AddAccount_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add another account" /></StackPanel></Button>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SignaturesPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Width="{Binding ViewportWidth, ElementName=SignaturesPage}" MaxWidth="760" HorizontalAlignment="Left" Spacing="14">
                            <StackPanel Spacing="5"><TextBlock Text="Signatures" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Create a signature per mailbox and choose where it appears." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="SignatureAccountPicker" Header="Mailbox" Style="{StaticResource GomailComboBoxStyle}" SelectionChanged="SignatureAccountPicker_SelectionChanged">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccountItem"><TextBlock Text="{x:Bind MailboxDisplay}" HorizontalAlignment="Stretch" TextAlignment="Left" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox x:Name="SignaturePicker" Grid.Column="1" Header="Signature" Style="{StaticResource GomailComboBoxStyle}" SelectionChanged="SignaturePicker_SelectionChanged" />
                            </Grid>
                            <TextBox x:Name="SignatureNameBox" Header="Signature name" Style="{StaticResource GomailFieldStyle}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Signature" />
                                <Border MinHeight="220" Background="{ThemeResource GomailCardBrush}" BorderBrush="{ThemeResource GomailBorderBrush}" BorderThickness="1" CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Size" Margin="2,0,3,0" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="SignatureFontSizePicker" Width="92" Height="32" MinHeight="32" Padding="10,0,30,0" Style="{StaticResource GomailComboBoxStyle}" SelectedIndex="1" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" ToolTipService.ToolTip="Font size" SelectionChanged="SignatureFontSizePicker_SelectionChanged">
                                                        <x:String>11 pt</x:String><x:String>13 pt</x:String><x:String>16 pt</x:String><x:String>20 pt</x:String><x:String>26 pt</x:String>
                                                    </ComboBox>
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Bold" Click="SignatureBold_Click"><FontIcon Glyph="&#xE8DD;" FontSize="13" /></Button>
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Italic" Click="SignatureItalic_Click"><FontIcon Glyph="&#xE8DB;" FontSize="13" /></Button>
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Underline" Click="SignatureUnderline_Click"><FontIcon Glyph="&#xE8DC;" FontSize="13" /></Button>
                                                    <Rectangle Width="1" Height="18" Margin="3,0" Fill="{ThemeResource GomailBorderBrush}" />
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Bulleted list" Click="SignatureBullet_Click"><FontIcon Glyph="&#xE8FD;" FontSize="13" /></Button>
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Undo" Click="SignatureUndo_Click"><FontIcon Glyph="&#xE7A7;" FontSize="13" /></Button>
                                                    <Button Style="{StaticResource GomailFormatButtonStyle}" ToolTipService.ToolTip="Redo" Click="SignatureRedo_Click"><FontIcon Glyph="&#xE7A6;" FontSize="13" /></Button>
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="{ThemeResource GomailBorderBrush}" />
                                        <RichEditBox x:Name="SignatureBodyEditor" Grid.Row="2" MinHeight="170" Padding="12,10" BorderThickness="0" Background="Transparent" FontSize="13" PlaceholderText="Write your signature…" IsSpellCheckEnabled="True" SelectionChanged="SignatureBodyEditor_SelectionChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <CheckBox x:Name="DefaultNewCheck" Content="Default for new messages">
                                    <CheckBox.Resources>
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="GomailAccentBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="GomailAccentBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="GomailAccentHoverBrush" />
                                    </CheckBox.Resources>
                                </CheckBox>
                                <CheckBox x:Name="DefaultReplyCheck" Content="Default for replies">
                                    <CheckBox.Resources>
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="GomailAccentBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="GomailAccentBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="GomailAccentHoverBrush" />
                                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="GomailAccentHoverBrush" />
                                    </CheckBox.Resources>
                                </CheckBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9"><Button Content="Save signature" Style="{StaticResource GomailPrimaryButtonStyle}" Click="SaveSignature_Click" /><Button Content="Delete" Style="{StaticResource GomailSecondaryButtonStyle}" Foreground="{ThemeResource GomailDangerBrush}" Click="DeleteSignature_Click" /></StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="Keyboard shortcuts" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Use familiar mail commands or assign combinations that fit your workflow." Foreground="{ThemeResource GomailSecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="To change a shortcut" Message="Select its field and press the new key combination. Press Backspace to turn a shortcut off." />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel x:Name="ShortcutRowsHost" Spacing="0" />
                            </Border>
                            <Button Content="Restore defaults" HorizontalAlignment="Left" Style="{StaticResource GomailSecondaryButtonStyle}" Click="ResetShortcuts_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IntegrationsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="Integrations" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Connection status for mail providers." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="OAuth is ready" Message="Microsoft and Google sign-in are included in this Inboxwell build. No developer credentials are required.">
                                <InfoBar.Resources>
                                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="GomailAccentSoftBrush" />
                                    <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="GomailAccentBrush" />
                                </InfoBar.Resources>
                            </InfoBar>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" Background="White" BorderBrush="#26747775" BorderThickness="1" CornerRadius="14"><Image Source="Assets/MicrosoftSignIn.svg" Width="23" Height="23" Stretch="Uniform" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Microsoft 365" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="OAuth is included. Connect Exchange Online, work, school, and supported Microsoft accounts without entering developer credentials." TextWrapping="Wrap" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource GomailSuccessBrush}" /><TextBlock Text="Ready" Foreground="{ThemeResource GomailSuccessBrush}" FontWeight="SemiBold" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" Background="#18D9574F" CornerRadius="14"><TextBlock Text="G" Foreground="#FFD9574F" FontFamily="Segoe UI Variable Display" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Google" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="OAuth is included in this Inboxwell build. Add Gmail accounts without entering developer credentials." TextWrapping="Wrap" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource GomailSuccessBrush}" /><TextBlock Text="Ready" Foreground="{ThemeResource GomailSuccessBrush}" FontWeight="SemiBold" /></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PrivacyPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="Security &amp; privacy" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Control remote content and how Inboxwell protects local mail." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" Background="{ThemeResource GomailAccentSoftBrush}" CornerRadius="14"><FontIcon Glyph="&#xE91B;" FontSize="19" Foreground="{ThemeResource GomailAccentBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="External images" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Images load automatically by default so newsletters and designed emails appear complete. Blocking them can reduce sender tracking." TextWrapping="Wrap" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                                    <ToggleSwitch x:Name="BlockRemoteImagesToggle" Grid.Column="2" Header="Block images" OffContent="Load automatically" OnContent="Blocked" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="{ThemeResource GomailAccentBrush}" HorizontalAlignment="Left" /><TextBlock Text="Encrypted mail database" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Messages and the search index are stored in a SQLCipher-encrypted database on this computer." TextWrapping="Wrap" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><StackPanel Spacing="8"><FontIcon Glyph="&#xE8D7;" FontSize="24" Foreground="{ThemeResource GomailAccentBrush}" HorizontalAlignment="Left" /><TextBlock Text="Protected credentials" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Passwords and OAuth tokens are stored in Windows Credential Manager. Attachments are cached with AES-GCM encryption." TextWrapping="Wrap" Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
                            <StackPanel Spacing="5"><TextBlock Text="About Inboxwell" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Version, source code and installation information." Foreground="{ThemeResource GomailSecondaryTextBrush}" /></StackPanel>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Image Width="64" Height="64" Source="Assets/InboxwellIcon.png" Stretch="Uniform" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="Inboxwell" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AboutVersionText" Text="Version" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource GomailAccentBrush}" />
                                        <TextBlock Text="A calm, private, open-source mail client for Windows." Foreground="{ThemeResource GomailSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Installation" FontSize="17" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Package version" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><TextBlock x:Name="AboutPackageVersionText" Grid.Column="1" /></Grid>
                                    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Architecture" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><TextBlock x:Name="AboutArchitectureText" Grid.Column="1" /></Grid>
                                    <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Installation type" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><TextBlock Text="Locally signed MSIX" Grid.Column="1" /></Grid>
                                </StackPanel>
                            </Border>
                            <Button Content="View source code on GitHub" HorizontalAlignment="Left" Style="{StaticResource GomailSecondaryButtonStyle}" Click="OpenSourceCode_Click" />
                            <TextBlock Text="© 2026 Denis Shchepetov. Inboxwell is open source under the MIT License." FontSize="11" Foreground="{ThemeResource GomailMutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource GomailSecondaryTextBrush}" /><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="Close" Style="{StaticResource GomailSecondaryButtonStyle}" Click="Close_Click" /><Button Content="Save changes" Style="{StaticResource GomailPrimaryButtonStyle}" Click="Save_Click" /></StackPanel></Grid>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactSettings">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="SettingsNavColumn.Width" Value="0" /><Setter Target="SettingsSidebar.Visibility" Value="Collapsed" /><Setter Target="CompactNavigation.Visibility" Value="Visible" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSettings">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="SettingsNavColumn.Width" Value="224" /><Setter Target="SettingsSidebar.Visibility" Value="Visible" /><Setter Target="CompactNavigation.Visibility" Value="Collapsed" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
