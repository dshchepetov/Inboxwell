<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Gomail_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gomail_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#FF2F6FED</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF5C8FF3</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF87AEF7</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFB7CEF9</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF245FD5</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF1E54C1</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF1948A8</Color>
                    <SolidColorBrush x:Key="GomailCanvasBrush" Color="#FFF7F4EF" />
                    <SolidColorBrush x:Key="GomailPanelBrush" Color="#F4FFFFFF" />
                    <SolidColorBrush x:Key="GomailReaderBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GomailMutedBrush" Color="#FFEEEAE3" />
                    <SolidColorBrush x:Key="GomailBorderBrush" Color="#FFD7D2C8" />
                    <SolidColorBrush x:Key="GomailSecondaryTextBrush" Color="#FF66707C" />
                    <SolidColorBrush x:Key="GomailMutedTextBrush" Color="#FF8B949E" />
                    <SolidColorBrush x:Key="GomailSelectionBrush" Color="#FFE6F0FF" />
                    <SolidColorBrush x:Key="GomailHoverBrush" Color="#FFF1F6FF" />
                    <SolidColorBrush x:Key="GomailPressedBrush" Color="#FFDCE9FC" />
                    <SolidColorBrush x:Key="GomailAccentBrush" Color="#FF2F6FED" />
                    <SolidColorBrush x:Key="GomailAccentHoverBrush" Color="#FF245FD5" />
                    <SolidColorBrush x:Key="GomailAccentSoftBrush" Color="#FFEAF1FF" />
                    <SolidColorBrush x:Key="GomailCardBrush" Color="#FFFCFBF8" />
                    <SolidColorBrush x:Key="GomailWarningBrush" Color="#FFFFF4D7" />
                    <SolidColorBrush x:Key="GomailWarningTextBrush" Color="#FF6D4B00" />
                    <SolidColorBrush x:Key="GomailDangerBrush" Color="#FFB42318" />
                    <SolidColorBrush x:Key="GomailSuccessBrush" Color="#FF167348" />
                    <SolidColorBrush x:Key="GomailHoverOverlayBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2F6FED" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF245FD5" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1E54C1" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF2F6FED" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF245FD5" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF1E54C1" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF2F6FED" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF245FD5" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF1E54C1" />

                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFE6F0FF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFDCE9FC" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FFF1F6FF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFD7D2C8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#FF6EA8FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF8BBAFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#FFA6C9FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFC4DAFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF5798F6</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF4388E9</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF3478D5</Color>
                    <SolidColorBrush x:Key="GomailCanvasBrush" Color="#FF1B1B1E" />
                    <SolidColorBrush x:Key="GomailPanelBrush" Color="#F425262A" />
                    <SolidColorBrush x:Key="GomailReaderBrush" Color="#FF202126" />
                    <SolidColorBrush x:Key="GomailMutedBrush" Color="#FF303136" />
                    <SolidColorBrush x:Key="GomailBorderBrush" Color="#FF3B3C42" />
                    <SolidColorBrush x:Key="GomailSecondaryTextBrush" Color="#FFAAB1BA" />
                    <SolidColorBrush x:Key="GomailMutedTextBrush" Color="#FF777F88" />
                    <SolidColorBrush x:Key="GomailSelectionBrush" Color="#FF18324D" />
                    <SolidColorBrush x:Key="GomailHoverBrush" Color="#FF2D3743" />
                    <SolidColorBrush x:Key="GomailPressedBrush" Color="#FF354659" />
                    <SolidColorBrush x:Key="GomailAccentBrush" Color="#FF6EA8FF" />
                    <SolidColorBrush x:Key="GomailAccentHoverBrush" Color="#FF8BBAFF" />
                    <SolidColorBrush x:Key="GomailAccentSoftBrush" Color="#FF213752" />
                    <SolidColorBrush x:Key="GomailCardBrush" Color="#FF292A2D" />
                    <SolidColorBrush x:Key="GomailWarningBrush" Color="#FF3D3320" />
                    <SolidColorBrush x:Key="GomailWarningTextBrush" Color="#FFFFD982" />
                    <SolidColorBrush x:Key="GomailDangerBrush" Color="#FFFF8A80" />
                    <SolidColorBrush x:Key="GomailSuccessBrush" Color="#FF7ADFA7" />
                    <SolidColorBrush x:Key="GomailHoverOverlayBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF6EA8FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF8BBAFF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFA6C9FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF6EA8FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF8BBAFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFA6C9FF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF6EA8FF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF8BBAFF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFA6C9FF" />

                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF18324D" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF24415E" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FF2D3743" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#CC25262A" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF303136" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF303136" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF3B3C42" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="GomailRoundedButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource GomailBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ScaleRoot" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="ButtonTransform" />
                                </Grid.RenderTransform>
                                <Border
                                    x:Name="ButtonSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{ThemeResource GomailHoverOverlayBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ScaleRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ScaleRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ScaleRoot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ScaleRoot" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GomailIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GomailRoundedButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="GomailPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GomailRoundedButtonStyle}">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{ThemeResource GomailAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="GomailSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GomailRoundedButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource GomailCardBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="GomailNavButtonStyle" TargetType="Button" BasedOn="{StaticResource GomailRoundedButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="GomailPillButtonStyle" TargetType="Button" BasedOn="{StaticResource GomailPrimaryButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
            </Style>

            <Style x:Key="GomailListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,3" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="GomailCountBadgeStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource GomailAccentBrush}" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>

            <Style x:Key="GomailFieldStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="{ThemeResource GomailCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GomailBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="GomailProviderCardStyle" TargetType="Button" BasedOn="{StaticResource GomailRoundedButtonStyle}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="MinHeight" Value="208" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource GomailCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GomailBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
